<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Status Bar Space -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIGN UP"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginTop="40dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For Your Health"
            android:textSize="18sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp" />

        <!-- Email Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:padding="16dp"
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="@android:color/white"
                android:backgroundTint="#E0E0E0"
                android:importantForAutofill="yes"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <!-- Password Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:padding="16dp"
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="@android:color/white"
                android:backgroundTint="#E0E0E0"
                android:importantForAutofill="yes"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <!-- Password Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use 8 or more characters"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_marginBottom="16dp"
            android:paddingStart="4dp" />

        <!-- Repeat Password Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repeat password"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etRepeatPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Repeat your password"
                android:inputType="textPassword"
                android:padding="16dp"
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="@android:color/white"
                android:backgroundTint="#E0E0E0"
                android:importantForAutofill="yes"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <!-- Terms Checkbox -->
        <LinearLayout
            android:id="@+id/termsContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:padding="4dp"
            android:contentDescription="Accept terms and conditions">

            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#9C27B0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I accept the Term"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginStart="8dp"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Sign Up Button - Сиреневый цвет -->
        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Sign Up"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF"
            android:contentDescription="Sign up button" />

        <!-- Sign In Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account?"
                android:textSize="14sp"
                android:textColor="#757575"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/tvSignIn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Sign in"
                android:textSize="14sp"
                android:textColor="#9C27B0"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Sign in link" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
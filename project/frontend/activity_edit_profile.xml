<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFBFE">

    <!-- Status Bar -->

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#9C27B0"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <!-- Avatar Placeholder -->
                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/avatar_background"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROFILE"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#9C27B0"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Physical Info Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Weight Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/profile_card_background"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="WEIGHT"
                        android:textSize="12sp"
                        android:textColor="#49454F"
                        android:textAllCaps="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etWeight"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:text="66"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1C1B1F"
                            android:background="@android:color/transparent"
                            android:inputType="number"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:padding="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KG"
                            android:textSize="12sp"
                            android:textColor="#49454F"
                            android:layout_marginStart="8dp"
                            android:padding="8dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Age Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/profile_card_background"
                    android:padding="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AGE"
                        android:textSize="12sp"
                        android:textColor="#49454F"
                        android:textAllCaps="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etAge"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:text="25"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1C1B1F"
                            android:background="@android:color/transparent"
                            android:inputType="number"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:padding="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YEARS"
                            android:textSize="12sp"
                            android:textColor="#49454F"
                            android:layout_marginStart="8dp"
                            android:padding="8dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Height Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/profile_card_background"
                    android:padding="16dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="HEIGHT"
                        android:textSize="12sp"
                        android:textColor="#49454F"
                        android:textAllCaps="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/etHeight"
                            android:layout_width="80dp"
                            android:layout_height="match_parent"
                            android:text="184"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1C1B1F"
                            android:background="@android:color/transparent"
                            android:inputType="number"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:padding="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CM"
                            android:textSize="12sp"
                            android:textColor="#49454F"
                            android:layout_marginStart="8dp"
                            android:padding="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Personal Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/profile_card_background"
                android:padding="24dp">

                <!-- Username -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="USERNAME"
                        android:textSize="12sp"
                        android:textColor="#49454F"
                        android:textAllCaps="true" />

                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="page.soobin"
                        android:textSize="16sp"
                        android:textColor="#1C1B1F"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:padding="16dp" />

                </LinearLayout>

                <!-- Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NAME"
                        android:textSize="12sp"
                        android:textColor="#49454F"
                        android:textAllCaps="true" />

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Soobin"
                        android:textSize="16sp"
                        android:textColor="#1C1B1F"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:padding="16dp" />

                </LinearLayout>

                <!-- Surname -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SURNAME"
                        android:textSize="12sp"
                        android:textColor="#49454F"
                        android:textAllCaps="true" />

                    <EditText
                        android:id="@+id/etSurname"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Choi"
                        android:textSize="16sp"
                        android:textColor="#1C1B1F"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:padding="16dp" />

                </LinearLayout>

                <!-- Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="EMAIL"
                        android:textSize="12sp"
                        android:textColor="#49454F"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="soob_ni@gmail.com"
                        android:textSize="16sp"
                        android:textColor="#1C1B1F"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:padding="16dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#9C27B0"
                android:textColor="#FFFFFF"
                android:layout_marginTop="32dp" />

        </LinearLayout>

    </ScrollView>
    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/white">

        <TextView
            android:id="@+id/plansTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Plans"
            android:textColor="@color/light_pink"
            android:textSize="14sp"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/newPlanTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="New plan"
            android:textColor="@color/light_pink"
            android:textSize="14sp"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profile"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
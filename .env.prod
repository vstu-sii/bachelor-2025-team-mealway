# Backend
DATABASE_URL=postgresql://mealway_prod:${POSTGRES_PASSWORD}@postgres:5432/mealway_db
LANGFUSE_HOST=https://langfuse.mealway.com
LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY}
DEBUG=false
ENVIRONMENT=production

# Postgres
POSTGRES_USER=mealway_prod
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mealway_db

# Grafana
GRAFANA_PASSWORD=secure_grafana_password
